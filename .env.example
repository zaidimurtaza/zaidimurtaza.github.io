# Site (GitHub Pages, static export). Used at build time only.
# URL of the Supabase Edge Function that runs the chat agent, no trailing slash, e.g.
#   https://<project-ref>.supabase.co/functions/v1/agent
# Leave empty and the chat answers in offline mode from src/content/profile.ts.
NEXT_PUBLIC_AGENT_URL=

# Agent secrets are NOT set here. Put them in supabase/.env.secrets (git-ignored):
#   GEMINI_API_KEY=...
#   (optional) GEMINI_MODEL=gemini-3.8-flash, RESEND_API_KEY=..., BOOKING_WEBHOOK_URL=...
# then: npx supabase secrets set --env-file supabase/.env.secrets
